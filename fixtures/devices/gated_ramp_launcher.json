  "task": {
    "title": "Gated ramp launcher",
    "goal_text": "A latched plunger is pressed back against a coil spring with a ball on its face. On release the spring and the actuator throw it forward; past the spring's rest point the plunger slows and the ball runs on alone. It climbs the locked ramp, then must shove a sprung gate plate off the ramp lip before it can fly. Climbing costs speed but buys launch angle and height; the gate takes a bite out of the shot and holds it outright if it arrives too slowly. Set pull-back, actuator command and tilt so the ball first touches the floor at the target distance along +y from the table centre.",
    "knobs": [
      {
        "name": "pullback",
        "low": -0.32,
        "high": -0.12,
        "unit": "m",
        "description": "plunger position on its rail before release; more negative pulls the plunger (and the ball with it) further back and compresses the spring more"
      },
      {
        "name": "drive",
        "low": 0.0,
        "high": 0.7,
        "unit": "-",
        "description": "command held on the linear actuator during the drive phase; it pushes the plunger forward alongside the spring"
      },
      {
        "name": "tilt",
        "low": 0.0,
        "high": 0.5,
        "unit": "rad",
        "description": "angle at which the take-off ramp is locked before the run; 0 leaves it flush with the rail, larger values raise its far end so the ball must run uphill before it reaches the gate"
      }
    ],
    "setup": [
      {
        "part": "plunger",
        "value": "pullback"
      },
      {
        "part": "ramp",
        "value": "tilt"
      }
    ],
    "phases": [
      {
        "duration": 0.5,
        "ctrl": {
          "drive": "drive"
        },
        "release": [
          "hold"
        ]
      },
      {
        "duration": 2.5,
        "ctrl": {},
        "release": []
      }
    ],
    "horizon": 3.0,
    "outcome": {
      "kind": "landing_point",
      "part": "ball",
      "axes": [
        "y"
      ]
    },
    "goal_space": [
      {
        "low": 0.71,
        "high": 1.22
      }
    ],
    "tolerance": 0.06,
    "budget": 54,
    "escalation": [
      "fewer sensors: the ball's position trace is gone, so the flight and the gate crossing can no longer be watched directly, only the carriage, the gate kick and where the ball lands",
      "smaller budget: 60 experiments down to 54, over the same three-knob action space with two stall boundaries inside it",
      "the gate plate can now be grown half again as tall at modification time, so the barrier the referee tests with is well outside anything the learner can have measured on the built device, and it is the only announced modification: there is no flight-geometry change to fall back on, the learner has to have modelled the gate contact itself",
      "the reachable band is trimmed at the top, so the window the shots have to be aimed into is a narrower slice of the device's authority"
    ],
    "modifiable": [
      {
        "part": "gate",
        "field": "size2",
        "low": 0.005,
        "high": 0.016
      }
    ]
  }
